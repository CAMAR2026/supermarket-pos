# Local development (already set in .env.development):
VITE_API_URL=/api
VITE_PROXY_TARGET=http://localhost:5000

# Production build. Set these on the frontend host (Vercel, Netlify, etc.).
# Do not add / at the end. VITE_API_URL must include /api.
# VITE_API_URL=https://your-api-host.onrender.com/api
