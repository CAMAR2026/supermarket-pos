# Local API
PORT=5000

# MongoDB Atlas. Database name is supermarket-pos.
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/supermarket-pos?retryWrites=true&w=majority

# Use a long random string in production. Never commit the real value.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated frontend origins allowed by CORS.
# Local plus the hosted frontend URL.
CLIENT_URL=http://localhost:5173,https://supermarket-pos-static-site.onrender.com
